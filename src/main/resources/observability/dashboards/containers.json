{
  "uid": "dm-containers",
  "title": "Containers",
  "description": "CPU, memory, network and disk of every container, from cAdvisor. Managed by Docker Manager.",
  "tags": ["docker-manager", "containers"],
  "editable": false,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "container",
        "label": "Container",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "dm-metrics" },
        "query": { "query": "label_values(container_last_seen{name!=\"\"}, name)", "refId": "q" },
        "definition": "label_values(container_last_seen{name!=\"\"}, name)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": { "text": "All", "value": "$__all" },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Running containers",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "dm-metrics" },
      "targets": [{ "refId": "A", "expr": "count(count by (name) (container_last_seen{name=~\"$container\"}))" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "none" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "CPU (cores)",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "dm-metrics" },
      "targets": [{ "refId": "A", "expr": "sum(rate(container_cpu_usage_seconds_total{name=~\"$container\"}[$__rate_interval]))" }],
      "fieldConfig": { "defaults": { "decimals": 2 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Memory in use",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "dm-metrics" },
      "targets": [{ "refId": "A", "expr": "sum(container_memory_working_set_bytes{name=~\"$container\"})" }],
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Restarts in range",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "dm-metrics" },
      "targets": [{ "refId": "A", "expr": "sum(changes(container_start_time_seconds{name=~\"$container\"}[$__range]))" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none" }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU by container (cores)",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "dm-metrics" },
      "targets": [{ "refId": "A", "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"$container\"}[$__rate_interval]))", "legendFormat": "{{name}}" }],
      "fieldConfig": { "defaults": { "decimals": 2, "custom": { "fillOpacity": 8 } } },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Memory by container",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "dm-metrics" },
      "targets": [{ "refId": "A", "expr": "sum by (name) (container_memory_working_set_bytes{name=~\"$container\"})", "legendFormat": "{{name}}" }],
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "fillOpacity": 8 } } },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Network received",
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "dm-metrics" },
      "targets": [{ "refId": "A", "expr": "sum by (name) (rate(container_network_receive_bytes_total{name=~\"$container\"}[$__rate_interval]))", "legendFormat": "{{name}}" }],
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "fillOpacity": 8 } } },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Network sent",
      "gridPos": { "x": 12, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "dm-metrics" },
      "targets": [{ "refId": "A", "expr": "sum by (name) (rate(container_network_transmit_bytes_total{name=~\"$container\"}[$__rate_interval]))", "legendFormat": "{{name}}" }],
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "fillOpacity": 8 } } },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Disk reads",
      "gridPos": { "x": 0, "y": 21, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "dm-metrics" },
      "targets": [{ "refId": "A", "expr": "sum by (name) (rate(container_fs_reads_bytes_total{name=~\"$container\"}[$__rate_interval]))", "legendFormat": "{{name}}" }],
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "fillOpacity": 8 } } },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Disk writes",
      "gridPos": { "x": 12, "y": 21, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "dm-metrics" },
      "targets": [{ "refId": "A", "expr": "sum by (name) (rate(container_fs_writes_bytes_total{name=~\"$container\"}[$__rate_interval]))", "legendFormat": "{{name}}" }],
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "fillOpacity": 8 } } },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" } }
    }
  ]
}
