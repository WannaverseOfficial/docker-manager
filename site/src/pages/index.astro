---
// The public product page. Docs live under /docs/ (Starlight); this page has its own layout so the hero can
// run edge to edge, like the app's home page.
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import { Image } from "astro:assets";
import overviewShot from "../assets/screens/overview.png";
import containersShot from "../assets/screens/containers.png";
import stacksShot from "../assets/screens/stacks.png";
import ingressShot from "../assets/screens/ingress.png";
import dnsShot from "../assets/screens/dns-zone.png";
import rolloutShot from "../assets/screens/rollout-canary.png";
import databaseShot from "../assets/screens/database-query.png";
import observabilityShot from "../assets/screens/observability.png";
import securityShot from "../assets/screens/security-report.png";
import { clarityScript } from "../analytics.mjs";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const url = (path: string) => `${base}${path}`;
const REPO = "https://github.com/WannaverseOfficial/docker-manager";
const HUB = "https://hub.docker.com/r/wannaverse/docker-manager";

const COMPOSE = `services:
  docker-manager:
    image: wannaverse/docker-manager:latest
    container_name: docker-manager
    pull_policy: always
    restart: unless-stopped
    ports:
      - "8080:8080"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - docker_manager_data:/app/database
      - /opt/docker-manager/stacks:/opt/docker-manager/stacks
      - /opt/docker-manager/git-repos:/opt/docker-manager/git-repos
    environment:
      - BASE_URL=http://your-server:8080

volumes:
  docker_manager_data:`;

const TRY = "docker run -d -p 8080:8080 -v /var/run/docker.sock:/var/run/docker.sock wannaverse/docker-manager";

// A trimmed copy of the complete example in docs/configuration.md.
const YAML = `version: 1

containers:
  api:
    host: web-01
    image: ghcr.io/acme/api:1.4.0
    env:
      PORT: 8080
    memoryMb: 512

ingress:
  web-01:
    acmeEmail: ops@example.com
    routes:
      api:
        hostname: api.example.com
        container: api
        port: 8080
        tls: lets-encrypt
        httpsRedirect: true

databases:
  main:
    host: web-01
    superuserPassword: \${env:PG_ADMIN_PASSWORD}
    backups: { intervalHours: 12, keep: 14 }
    databases:
      app: { owner: app }`;

// Hero: the painting follows the phrase you point at.
const VERBS = [
  { key: "containers", text: "run containers and stacks", href: "/docs/run/containers/" },
  { key: "ingress", text: "publish apps over HTTPS", href: "/docs/deploy/ingress/" },
  { key: "dns", text: "host your own DNS", href: "/docs/deploy/dns/" },
  { key: "rollouts", text: "release without downtime", href: "/docs/deploy/rollouts/" },
  { key: "databases", text: "back up your databases", href: "/docs/data/databases/" },
  { key: "observability", text: "watch every container", href: "/docs/watch/observability/" },
];

const FEATURES = [
  { art: "containers", label: "Containers and stacks", href: "/docs/run/containers/",
    pitch: "Start, stop, read logs, open a shell and edit containers. Compose stacks keep every deploy as a version you can go back to." },
  { art: "ingress", label: "Ingress and HTTPS", href: "/docs/deploy/ingress/",
    pitch: "Publish containers on your own domains through a built-in proxy, with Let's Encrypt certificates that renew themselves." },
  { art: "dns", label: "DNS", href: "/docs/deploy/dns/",
    pitch: "Host your domains' DNS on the server, like Route 53. Routes get their records by themselves, with DNSSEC and failover." },
  { art: "rollouts", label: "Rollouts", href: "/docs/deploy/rollouts/",
    pitch: "Blue/green and canary releases, with tests before visitors see a new version and automatic rollback." },
  { art: "deploy", label: "Git and pipelines", href: "/docs/deploy/git-pipelines/",
    pitch: "Connect a repository and build and deploy on every push, with pipelines for your tests." },
  { art: "databases", label: "PostgreSQL databases", href: "/docs/data/databases/",
    pitch: "Servers with secure defaults, a SQL console, users and access, scheduled backups and copies to S3." },
  { art: "observability", label: "Observability", href: "/docs/watch/observability/",
    pitch: "Grafana with Prometheus, Mimir, Loki and Tempo, already connected, collecting logs, metrics and traces." },
  { art: "security", label: "Security scanning", href: "/docs/watch/security/",
    pitch: "Scan images with Trivy or Docker Scout, check the host against the CIS Docker Benchmark, and fix findings in a click." },
  { art: "registry", label: "Private registry", href: "/docs/data/registry/",
    pitch: "Your own Docker registry with its own users, served over HTTPS through ingress or kept on the server." },
];

const SHOWCASE = [
  { key: "overview", label: "Overview", img: overviewShot, alt: "The overview of a Docker host: containers, stacks, images and recent activity." },
  { key: "containers", label: "Containers", img: containersShot, alt: "The containers on a host, with their state, image and ports." },
  { key: "stacks", label: "Stacks", img: stacksShot, alt: "Compose stacks, including ones started outside Docker Manager." },
  { key: "ingress", label: "Ingress", img: ingressShot, alt: "Ingress routes with HTTPS certificates and sign-in." },
  { key: "dns", label: "DNS", img: dnsShot, alt: "A DNS zone with its records." },
  { key: "rollouts", label: "Rollouts", img: rolloutShot, alt: "A canary release in progress." },
  { key: "databases", label: "Databases", img: databaseShot, alt: "The SQL console of a PostgreSQL database." },
  { key: "observability", label: "Observability", img: observabilityShot, alt: "The observability page of a host." },
  { key: "security", label: "Security", img: securityShot, alt: "A vulnerability report with fixed versions." },
];

const WHY = [
  { title: "One container, everything included", body: "Containers, stacks, ingress, DNS, databases, observability, a registry and scanning. No separate tools to wire together." },
  { title: "Free, with no feature gates", body: "MIT licensed and developed in the open. No subscriptions, no licence fees and no paid tier." },
  { title: "Changes you can take back", body: "Edits keep volumes and put the original back if the new container doesn't start. Every change is recorded, with one-click undo." },
  { title: "Ready for a team", body: "Users with roles and per-host permissions, an audit log, email alerts, and sign-in pages in front of your apps." },
];

const STEPS = [
  { title: "Start it", body: "Run one container with access to Docker. The host it runs on is added automatically." },
  { title: "Sign in", body: "Sign in as admin with the password from the container logs, then choose your own." },
  { title: "Add your apps", body: "Start from a template, paste a compose file, import what's already running, or connect a git repository." },
];
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Docker Manager: your Docker server, all in one place</title>
    <meta name="description" content="Docker Manager is a free, open-source, self-hosted web interface for Docker: containers, Compose stacks, HTTPS ingress, DNS, PostgreSQL databases, observability, a private registry and security scanning, in one container." />
    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
    <meta property="og:title" content="Docker Manager" />
    <meta property="og:description" content="Your Docker server, all in one place. Free, open source and self-hosted." />
    <meta property="og:image" content={new URL(url("/art/hero.webp"), Astro.site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Same choice as the docs (Starlight stores it as "starlight-theme"); otherwise follow the system.
      try {
        const t = localStorage.getItem("starlight-theme");
        const theme = t === "light" || t === "dark" ? t : matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    {clarityScript && <script is:inline set:html={clarityScript} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <div class="wrap top-inner">
        <a class="logo" href={url("/")}>
          <img src={url("/favicon.svg")} alt="" width="22" height="27" />
          Docker Manager
        </a>
        <nav aria-label="Main">
          <a href="#features">Features</a>
          <a href={url("/docs/")}>Docs</a>
          <a class="icon-link" href={REPO} aria-label="Docker Manager on GitHub">
            <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
          </a>
          <a class="btn btn-small" href="#install">Install</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <!-- Hero: the painting follows the phrase you point at. -->
      <section class="hero" aria-labelledby="hero-title">
        <img class="art is-on" data-art="hero" src={url("/art/hero.webp")} alt="" fetchpriority="high" />
        {VERBS.map((v) => <img class="art" data-art={v.key} src={url(`/art/${v.key}.webp`)} alt="" loading="lazy" />)}
        <div class="shade" aria-hidden="true"></div>
        <div class="wrap hero-inner">
          <a class="pill" href={REPO}>Free and open source, MIT licensed</a>
          <h1 id="hero-title">Docker Manager helps you</h1>
          <ul class="verbs">
            {VERBS.map((v) => (
              <li><a href={url(v.href)} data-verb={v.key}>{v.text}</a></li>
            ))}
          </ul>
          <p class="lede">
            A self-hosted web interface for your Docker servers. Containers, Compose stacks, HTTPS, DNS, databases,
            monitoring and security scanning, in one container, without subscriptions or feature gates.
          </p>
          <div class="actions">
            <a class="btn" href="#install">Get Docker Manager</a>
            <a class="btn btn-ghost" href={url("/docs/")}>Read the docs</a>
          </div>
        </div>
      </section>

      <div class="wrap">
        <!-- Product -->
        <section class="band" aria-labelledby="see">
          <div class="intro">
            <h2 id="see">See your whole server at a glance</h2>
            <p class="muted">
              Everything Docker can do, laid out in plain pages: what's running, what changed, what needs attention,
              and the button to fix it.
            </p>
          </div>
          <div class="tabs" role="tablist" aria-label="Screens">
            {SHOWCASE.map((s, i) => (
              <button type="button" role="tab" id={`tab-${s.key}`} aria-controls={`panel-${s.key}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>{s.label}</button>
            ))}
          </div>
          <div class="showcase">
            {SHOWCASE.map((s, i) => (
              <figure class="shot" role="tabpanel" id={`panel-${s.key}`} aria-labelledby={`tab-${s.key}`} hidden={i !== 0}>
                <Image src={s.img} alt={s.alt} widths={[720, 1440]} sizes="(min-width: 1120px) 1056px, 100vw" loading={i === 0 ? "eager" : "lazy"} />
              </figure>
            ))}
          </div>
        </section>

        <!-- Features -->
        <section id="features" class="band" aria-labelledby="features-title">
          <div class="intro">
            <h2 id="features-title">Everything a Docker server needs</h2>
            <p class="muted">
              The tools you'd otherwise set up one by one, already connected to each other. Publish a container and
              it gets its certificate and its DNS record, and with observability on, its logs and metrics show up in Grafana.
            </p>
          </div>
          <ul class="cards">
            {FEATURES.map((f) => (
              <li>
                <a class="card" href={url(f.href)}>
                  <div class="card-art"><img src={url(`/art/${f.art}.webp`)} alt="" loading="lazy" /></div>
                  <div class="card-body">
                    <h3>{f.label}</h3>
                    <p class="muted">{f.pitch}</p>
                    <span class="more">How it works</span>
                  </div>
                </a>
              </li>
            ))}
          </ul>
          <p class="links also">
            <span class="muted">Also:</span>
            <a href={url("/docs/watch/health/")}>Health checks and email alerts</a>
            <a href={url("/docs/admin/hosts/")}>Remote hosts over TLS or SSH</a>
            <a href={url("/docs/admin/users/")}>Users, roles and permissions</a>
            <a href={url("/docs/watch/policies/")}>Image rules</a>
            <a href={url("/docs/run/templates/")}>App templates</a>
            <a href={url("/docs/admin/history/")}>History with undo</a>
          </p>
        </section>

        <!-- Why -->
        <section class="band" aria-labelledby="why">
          <h2 id="why">Built for homelabs, developers and small teams</h2>
          <ul class="why">
            {WHY.map((w) => (
              <li>
                <h3>{w.title}</h3>
                <p class="muted">{w.body}</p>
              </li>
            ))}
          </ul>
        </section>

        <!-- Install -->
        <section id="install" class="band" aria-labelledby="install-title">
          <div class="split">
            <div>
              <h2 id="install-title">Up and running in a minute</h2>
              <p class="muted">
                Save this as <code>docker-compose.yml</code> on your server and run <code>docker compose up -d</code>.
                Then open port 8080 and sign in as <code>admin</code> with the password printed by
                <code>docker logs docker-manager</code>.
              </p>
              <ol class="steps">
                {STEPS.map((s, i) => (
                  <li>
                    <span class="num" aria-hidden="true">{i + 1}</span>
                    <div>
                      <h3>{s.title}</h3>
                      <p class="muted">{s.body}</p>
                    </div>
                  </li>
                ))}
              </ol>
              <p class="links">
                <a href={url("/docs/start/install/")}>Step-by-step install</a>
                <a href={url("/docs/start/first-steps/")}>First steps</a>
                <a href={HUB}>Docker Hub</a>
              </p>
            </div>
            <div>
              <div class="code-wrap">
                <pre class="code"><code id="compose">{COMPOSE}</code></pre>
                <button type="button" class="copy" data-copy="compose">Copy</button>
              </div>
              <p class="small cmd-label">Just trying it out?</p>
              <div class="cmd">
                <code id="try-cmd">{TRY}</code>
                <button type="button" class="copy" data-copy="try-cmd">Copy</button>
              </div>
            </div>
          </div>
        </section>

        <!-- Configuration as code -->
        <section class="band split" aria-labelledby="iac">
          <div>
            <h2 id="iac">Or describe it all in one file</h2>
            <p class="muted">
              Hosts, users, containers, stacks, ingress routes, DNS zones, databases, rollouts and pipelines can all
              live in one YAML file. Preview the changes, apply them, and keep the file in git. Think of it as
              CloudFormation or Terraform for your Docker server.
            </p>
            <p class="muted">
              Docker Manager puts back anything the file manages if it's removed by other means, and locks it in the
              interface so nobody changes it by hand.
            </p>
            <p class="links">
              <a href={url("/docs/admin/configuration-as-code/")}>Configuration as code</a>
              <a href={url("/docs/reference/configuration-file/")}>File reference</a>
            </p>
          </div>
          <pre class="code"><code>{YAML}</code></pre>
        </section>

        <!-- Call to action -->
        <section class="cta" aria-labelledby="cta">
          <img src={url("/art/night.webp")} alt="" loading="lazy" />
          <div class="cta-inner">
            <h2 id="cta">Your server, your rules, no monthly bill.</h2>
            <p>Install Docker Manager, add your apps, and run them like you have a platform team.</p>
            <div class="actions">
              <a class="btn" href={url("/docs/start/install/")}>Get started</a>
              <a class="btn btn-ghost" href={REPO}>View on GitHub</a>
            </div>
          </div>
        </section>
      </div>
    </main>

    <footer class="foot">
      <div class="wrap foot-grid">
        <div>
          <a class="logo" href={url("/")}>
            <img src={url("/favicon.svg")} alt="" width="22" height="27" />
            Docker Manager
          </a>
          <p class="muted small">A free, open-source, self-hosted web interface for running Docker servers.</p>
        </div>
        <nav aria-label="Start">
          <h2>Start</h2>
          <a href={url("/docs/")}>What is Docker Manager?</a>
          <a href={url("/docs/start/install/")}>Install</a>
          <a href={url("/docs/start/first-steps/")}>First steps</a>
          <a href={url("/docs/start/update/")}>Updating</a>
        </nav>
        <nav aria-label="Learn">
          <h2>Learn</h2>
          <a href={url("/docs/deploy/ingress/")}>Ingress and HTTPS</a>
          <a href={url("/docs/deploy/dns/")}>DNS</a>
          <a href={url("/docs/admin/configuration-as-code/")}>Configuration as code</a>
          <a href={url("/docs/reference/troubleshooting/")}>Troubleshooting</a>
        </nav>
        <nav aria-label="Project">
          <h2>Project</h2>
          <a href={REPO}>Source code</a>
          <a href={`${REPO}/issues`}>Report a problem</a>
          <a href={HUB}>Docker Hub</a>
          <a href={`${REPO}/blob/main/LICENSE`}>MIT licence</a>
        </nav>
      </div>
      <div class="wrap legal muted small">© 2026 <a href="https://wannaverse.com">Wannaverse</a>. Open source under the MIT licence.</div>
    </footer>

    <script>
      // Hero: point at a phrase and the painting behind it changes.
      const arts = document.querySelectorAll<HTMLImageElement>(".hero .art");
      const show = (key: string) => arts.forEach((a) => a.classList.toggle("is-on", a.dataset.art === key));
      document.querySelectorAll<HTMLAnchorElement>("[data-verb]").forEach((link) => {
        const key = link.dataset.verb!;
        const on = () => { show(key); link.closest(".verbs")?.classList.add("has-active"); link.classList.add("active"); };
        const off = () => { show("hero"); link.closest(".verbs")?.classList.remove("has-active"); link.classList.remove("active"); };
        link.addEventListener("mouseenter", on);
        link.addEventListener("focus", on);
        link.addEventListener("mouseleave", off);
        link.addEventListener("blur", off);
      });

      // Screens: tabs with arrow-key support.
      const tabs = [...document.querySelectorAll<HTMLButtonElement>(".tabs [role=tab]")];
      const select = (tab: HTMLButtonElement) => {
        tabs.forEach((t) => {
          const on = t === tab;
          t.setAttribute("aria-selected", String(on));
          t.tabIndex = on ? 0 : -1;
          document.getElementById(t.getAttribute("aria-controls")!)!.hidden = !on;
        });
      };
      tabs.forEach((tab, i) => {
        tab.addEventListener("click", () => select(tab));
        tab.addEventListener("keydown", (e) => {
          const step = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
          if (!step) return;
          const next = tabs[(i + step + tabs.length) % tabs.length];
          select(next);
          next.focus();
          e.preventDefault();
        });
      });

      document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const text = document.getElementById(btn.dataset.copy!)?.textContent ?? "";
          try {
            await navigator.clipboard.writeText(text);
            btn.textContent = "Copied";
          } catch {
            btn.textContent = "Select and copy";
          }
          setTimeout(() => (btn.textContent = "Copy"), 1600);
        });
      });
    </script>

    <style is:global>
      :root {
        --fog: #0b0b0c; --paper: #161618; --well: #222225; --line: #2e2e32;
        --ink: #ececee; --slate: #a8a8ae; --accent: #ececee; --accent-ink: #0a0a0a;
        color-scheme: dark;
      }
      :root[data-theme="light"] {
        --fog: #fafafa; --paper: #ffffff; --well: #f0f0f0; --line: #e4e4e4;
        --ink: #18181b; --slate: #5f5f66; --accent: #18181b; --accent-ink: #fafafa;
        color-scheme: light;
      }
      *, *::before, *::after { box-sizing: border-box; }
      html { background: var(--fog); color: var(--ink); scroll-behavior: smooth; }
      body {
        margin: 0; background: var(--fog); color: var(--ink);
        font-family: "Inter Variable", system-ui, sans-serif; font-size: 16px; line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }
      img { display: block; max-width: 100%; height: auto; }
      a { color: inherit; }
      code { font-family: "JetBrains Mono Variable", ui-monospace, monospace; font-size: 0.9em; }
      h1, h2, h3 { margin: 0; font-weight: 600; letter-spacing: -0.02em; line-height: 1.2; }
      h2 { font-size: clamp(1.6rem, 3vw, 1.95rem); }
      h3 { font-size: 1.05rem; }
      p { margin: 0; }
      ul, ol { margin: 0; padding: 0; list-style: none; }
      :focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; border-radius: 4px; }

      .wrap { width: 100%; max-width: 1120px; margin: 0 auto; padding: 0 16px; }
      @media (min-width: 640px) { .wrap { padding: 0 32px; } }
      .muted { color: var(--slate); }
      .small { font-size: 14px; }
      .skip { position: absolute; left: -9999px; }
      .skip:focus { left: 16px; top: 12px; z-index: 50; background: var(--paper); padding: 8px 12px; border-radius: 8px; }

      /* Header floats over the hero. */
      .top { position: absolute; inset: 0 0 auto; z-index: 10; color: #fff; }
      .top-inner { display: flex; align-items: center; justify-content: space-between; height: 72px; gap: 12px; }
      .logo { display: inline-flex; align-items: center; gap: 10px; font-weight: 700; font-size: 1.15rem; letter-spacing: -0.03em; text-decoration: none; white-space: nowrap; }
      .top nav { display: flex; align-items: center; gap: 6px; font-size: 15px; }
      .top nav > a:not(.btn) { text-decoration: none; padding: 6px 10px; border-radius: 999px; opacity: 0.85; }
      .top nav > a:not(.btn):hover { opacity: 1; background: rgba(255, 255, 255, 0.1); }
      .icon-link { display: inline-grid; place-items: center; }
      @media (max-width: 560px) { .top nav > a[href="#features"] { display: none; } }

      .btn {
        display: inline-flex; align-items: center; gap: 8px; height: 44px; padding: 0 20px; border-radius: 999px;
        background: #fff; color: #000; font-weight: 500; font-size: 15px; text-decoration: none; border: 0;
        transition: opacity 0.2s; white-space: nowrap;
      }
      .btn:hover { opacity: 0.88; }
      .btn-small { height: 34px; padding: 0 14px; font-size: 14px; margin-left: 6px; }
      .btn-ghost { background: rgba(0, 0, 0, 0.25); color: #fff; border: 1px solid rgba(255, 255, 255, 0.3); backdrop-filter: blur(8px); }
      .btn-ghost:hover { background: rgba(255, 255, 255, 0.1); opacity: 1; }

      /* Hero */
      .hero { position: relative; isolation: isolate; overflow: hidden; display: flex; align-items: flex-end; min-height: min(96vh, 920px); color: #fff; }
      .hero .art { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; opacity: 0; transition: opacity 0.6s ease; }
      .hero .art.is-on { opacity: 1; }
      .shade { position: absolute; inset: 0; z-index: -1;
        background: linear-gradient(to right, rgba(0,0,0,0.82), rgba(0,0,0,0.5) 50%, rgba(0,0,0,0.08)),
                    linear-gradient(to top, rgba(0,0,0,0.75), transparent 66%); }
      .hero-inner { padding-top: 110px; padding-bottom: 72px; }
      .pill { display: inline-flex; align-items: center; height: 32px; padding: 0 14px; border-radius: 999px; font-size: 13px;
        text-decoration: none; border: 1px solid rgba(255,255,255,0.25); background: rgba(255,255,255,0.1); backdrop-filter: blur(8px); }
      .pill:hover { background: rgba(255,255,255,0.2); }
      .hero h1, .verbs a { font-size: clamp(2rem, 4.4vw, 3.4rem); font-weight: 500; letter-spacing: -0.03em; }
      .hero h1 { margin-top: 24px; line-height: 1.05; color: rgba(255,255,255,0.65); }
      .verbs { margin-top: 8px; }
      .verbs a { display: inline-block; line-height: 1.12; text-decoration: none; transition: opacity 0.3s; }
      .verbs.has-active a:not(.active) { opacity: 0.35; }
      .verbs a.active::after { content: ""; display: inline-block; width: 0.08em; height: 0.85em; margin-left: 0.08em;
        background: currentColor; vertical-align: -0.08em; animation: blink 1s steps(1) infinite; }
      @keyframes blink { 50% { opacity: 0; } }
      .lede { margin-top: 28px; font-size: 18px; color: rgba(255,255,255,0.84); max-width: 58ch; }
      .actions { margin-top: 28px; display: flex; flex-wrap: wrap; gap: 12px; }

      /* Sections */
      .band { padding: 72px 0; border-top: 1px solid var(--line); }
      .band:first-child { border-top: 0; }
      .intro { max-width: 62ch; margin-bottom: 32px; }
      .intro .muted, .split .muted { margin-top: 10px; }
      .split { display: grid; gap: 32px; align-items: start; }
      .split > * { min-width: 0; }
      @media (min-width: 900px) { .split { grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); } }
      .links { margin-top: 20px; display: flex; flex-wrap: wrap; gap: 8px 24px; font-size: 15px; }
      .links a { text-underline-offset: 4px; }
      .also { margin-top: 28px; }

      /* Screens */
      .tabs { display: flex; gap: 6px; overflow-x: auto; padding-bottom: 4px; margin-bottom: 16px; scrollbar-width: thin; }
      .tabs button { flex: none; height: 36px; padding: 0 14px; border-radius: 999px; border: 1px solid var(--line);
        background: transparent; color: var(--slate); font: inherit; font-size: 14px; cursor: pointer; }
      .tabs button:hover { color: var(--ink); border-color: var(--slate); }
      .tabs button[aria-selected="true"] { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
      .shot { margin: 0; }
      .shot img { border: 1px solid var(--line); border-radius: 14px; width: 100%; }

      .cards { display: grid; gap: 16px; }
      @media (min-width: 640px) { .cards { grid-template-columns: repeat(2, 1fr); } }
      @media (min-width: 1000px) { .cards { grid-template-columns: repeat(3, 1fr); } }
      .card { display: block; height: 100%; text-decoration: none; border: 1px solid var(--line); background: var(--paper);
        border-radius: 18px; overflow: hidden; transition: border-color 0.2s; }
      .card:hover { border-color: var(--slate); }
      .card-art { aspect-ratio: 16 / 8; overflow: hidden; }
      .card-art img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s; }
      .card:hover .card-art img { transform: scale(1.03); }
      .card-body { padding: 20px; }
      .card-body .muted { font-size: 15px; margin-top: 6px; }
      .more { display: inline-block; margin-top: 14px; font-size: 14px; text-decoration: underline; text-underline-offset: 3px; }

      .why { margin-top: 36px; display: grid; gap: 32px; }
      @media (min-width: 640px) { .why { grid-template-columns: repeat(2, 1fr); } }
      @media (min-width: 1000px) { .why { grid-template-columns: repeat(4, 1fr); } }
      .why .muted { font-size: 15px; margin-top: 6px; }

      .steps { margin-top: 28px; display: grid; gap: 20px; }
      .steps li { display: flex; gap: 16px; align-items: flex-start; }
      .steps .muted { font-size: 15px; margin-top: 2px; }
      .num { flex: none; display: inline-grid; place-items: center; width: 32px; height: 32px; border-radius: 999px; background: var(--well); font-size: 14px; font-weight: 500; }

      .code { margin: 0; background: var(--paper); border: 1px solid var(--line); border-radius: 18px; padding: 20px;
        overflow-x: auto; font-size: 13px; line-height: 1.65; }
      .code-wrap { position: relative; }
      .code-wrap .copy { position: absolute; top: 12px; right: 12px; }
      .cmd { display: flex; align-items: center; gap: 8px; background: var(--paper); border: 1px solid var(--line);
        border-radius: 16px; padding: 12px 12px 12px 18px; }
      .cmd code { flex: 1; min-width: 0; overflow-x: auto; white-space: nowrap; font-size: 13px; }
      .copy { flex: none; height: 32px; padding: 0 14px; border-radius: 999px; border: 1px solid var(--line);
        background: var(--well); color: var(--ink); font: inherit; font-size: 14px; cursor: pointer; }
      .copy:hover { border-color: var(--slate); }
      .cmd-label { margin: 24px 0 8px; font-weight: 500; }
      #install code:not(pre code):not(.cmd code) { background: var(--well); padding: 1px 6px; border-radius: 6px; white-space: nowrap; }

      .cta { position: relative; isolation: isolate; overflow: hidden; border-radius: 18px; color: #fff; margin-top: 16px; }
      .cta img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
      .cta::after { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(to right, rgba(0,0,0,0.8), rgba(0,0,0,0.25)); }
      .cta-inner { padding: 72px 24px; }
      @media (min-width: 640px) { .cta-inner { padding: 80px 40px; } }
      .cta h2 { max-width: 22ch; }
      .cta p { margin-top: 8px; color: rgba(255,255,255,0.84); max-width: 52ch; }

      .foot { margin-top: 80px; border-top: 1px solid var(--line); }
      .foot-grid { padding-top: 56px; padding-bottom: 40px; display: grid; gap: 32px; }
      @media (min-width: 800px) { .foot-grid { grid-template-columns: 1.6fr 1fr 1fr 1fr; } }
      .foot-grid > div .muted { margin-top: 10px; max-width: 34ch; }
      .foot nav { display: flex; flex-direction: column; gap: 8px; font-size: 14px; }
      .foot nav h2 { font-size: 13px; font-weight: 500; color: var(--slate); letter-spacing: 0; margin-bottom: 4px; }
      .foot nav a { text-decoration: none; }
      .foot nav a:hover { text-decoration: underline; text-underline-offset: 3px; }
      .legal { padding-top: 20px; padding-bottom: 28px; border-top: 1px solid var(--line); }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .hero .art, .card-art img, .verbs a { transition: none; }
        .verbs a.active::after { animation: none; }
      }
    </style>
  </body>
</html>
